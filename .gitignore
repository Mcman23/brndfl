# ==========================================================================
# BRANDFULL — .gitignore
# ==========================================================================

# --- Sirler / gizli melumatlar (HEC VAXT push edilmemelidir) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key

# --- Asililiqlar ---
node_modules/
backend/node_modules/
package-lock.json.bak

# --- Qurulus / dist ---
backend/dist/
dist/
build/

# --- Istifadeci yuklemeleri ---
uploads/
backend/uploads/
!uploads/.gitkeep

# --- Boyuk media fayllari (Git ucun uygun deyil) ---
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.zip
*.rar

# --- Ehtiyat nusxeler ve muveqqeti fayllar ---
*.bak
*.bak-*
*.bak2-*
*.bak3-*
*.bak4-*
*.bak5-*
*.bak6-*
*.bak7-*
*.current-backup
*.orig
*.tmp
_silinecek/
scratch/
scratchpad*
audit_report.txt

# --- Loglar ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Redaktor / IS ---
.vscode/
.idea/
.claude/
*.swp
*.swo

# --- Emeliyyat sistemi ---
.DS_Store
Thumbs.db
desktop.ini

# --- Prisma ---
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/migrations/dev/

# Muveqqeti yoxlama fayli
CLAUDE-NISAN.txt
brandful/
brandful/
brandful/
