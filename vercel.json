{
  "buildCommand": "cd backend && npm install --include=dev && npx prisma generate",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**",
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
